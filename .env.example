# ============================================
# WBAcademy — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="WBAcademy"
NODE_ENV=development

# Database (PostgreSQL via Supabase or Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/wbacademy_db"
DIRECT_URL="postgresql://postgres:password@localhost:5432/wbacademy_db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-32-char-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Email (Resend — resend.com)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@wbacademy.com"

# OpenAI
OPENAI_API_KEY="sk-your-openai-key"
AI_MODEL="gpt-4o"

# Stripe (stripe.com/docs)
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_key"

# Encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY="generate-a-32-byte-hex-key-with-openssl-rand-hex-32"

# Admin seed account
ADMIN_EMAIL="admin@wbacademy.com"
ADMIN_PASSWORD="change-this-in-production"
